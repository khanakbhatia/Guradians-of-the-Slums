# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=

# MongoDB
MONGO_URI=mongodb://localhost:27017/app_db

# Access token (short-lived JWT)
JWT_SECRET=changeme_use_a_long_random_value
JWT_EXPIRES_IN=15m

# Refresh token (opaque random value, hashed at rest, httpOnly cookie)
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=refreshToken

# Email verification / password reset
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
REQUIRE_EMAIL_VERIFICATION=false

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Outbound email (SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Guardians Platform <no-reply@example.com>"

# Logging
MORGAN_FORMAT=dev
WINSTON_LOG_LEVEL=debug
LOG_RETENTION_DAYS=14
MONGO_DEBUG_LOGGING=false

# AI service (services/ibm/*) — the Node backend's only AI integration
# point. Points at the Python ai_service (FastAPI + BeeAI + IBM Granite);
# see ai_service/.env.example for that process's own configuration
# (it runs Granite against a local Ollama-compatible runtime by default).
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT_MS=15000
AI_SERVICE_MAX_RETRIES=2
AI_SERVICE_RETRY_DELAY_MS=500

# Legacy / reserved IBM service layer vars — not read directly by any
# Node HTTP call today (ai_service owns the actual Granite/BeeAI
# credentials on its side). Kept for services/ibm/IBMServiceBase.js's
# isConfigured() diagnostics and reserved for a future hosted watsonx.ai
# backend (IBM_API_KEY/IBM_PROJECT_ID/IBM_URL).
WATSONX_API_KEY=
WATSONX_URL=
WATSONX_PROJECT_ID=

GRANITE_MODEL_ID=

BEEAI_ENDPOINT=
BEEAI_API_KEY=

RAG_VECTOR_STORE_URL=
RAG_API_KEY=
RAG_COLLECTION_NAME=

DATAPREP_ENDPOINT=
DATAPREP_API_KEY=

IBM_API_KEY=
IBM_PROJECT_ID=
IBM_URL=
